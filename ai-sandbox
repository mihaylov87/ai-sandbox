#!/usr/bin/env bash
# ai-sandbox v2 launcher (spec §4). Bash 3.2 compatible.
# Runs a coding-agent harness inside a kernel-enforced sandbox and stays as its parent.
set -euo pipefail

# ---------------------------------------------------------------------------
# Step 1: resolve the install dir through symlinks; refuse a writable install.

_ais_self=$0
while [ -L "$_ais_self" ]; do
  _ais_link=$(readlink "$_ais_self")
  case "$_ais_link" in
    /*) _ais_self=$_ais_link ;;
    *) _ais_self=$(dirname "$_ais_self")/$_ais_link ;;
  esac
done
AIS_INSTALL_DIR=$(cd "$(dirname "$_ais_self")" && pwd -P)
unset _ais_self _ais_link

. "$AIS_INSTALL_DIR/lib/config.sh"
. "$AIS_INSTALL_DIR/lib/policy.sh"
for _ais_lib in env exitreport net gates; do
  [ -f "$AIS_INSTALL_DIR/lib/$_ais_lib.sh" ] && . "$AIS_INSTALL_DIR/lib/$_ais_lib.sh"
done
unset _ais_lib

_ais_writable=$(find "$AIS_INSTALL_DIR" ! -type l \( -perm -020 -o -perm -002 \) -print 2>/dev/null | head -n 1)
[ -z "$_ais_writable" ] ||
  ais_die 126 "install dir is group- or world-writable: $_ais_writable (run: chmod -R go-w $AIS_INSTALL_DIR)"
unset _ais_writable

# Call a hook if a later work package defined it.
ais_hook() { # name args...
  if declare -F "$1" >/dev/null; then "$@"; fi
}

# ---------------------------------------------------------------------------
# Step 2: platform and backend.
#
# Backend interface (lib/backend-<name>.sh; tests/unit/backend-stub.sh for tests):
#   backend_preflight                       dependencies, nesting checks; exit 126 on failure
#   backend_compile IR SESSION              write the compiled policy into SESSION
#   backend_print SESSION                   print the compiled policy (--print-policy)
#   backend_command SESSION CWD -- CMD...   set AIS_RUN_ARGV (argv to exec on the host)
#                                           and AIS_RUN_CWD (host cwd for it, may be empty);
#                                           optional AIS_RUN_ENV=0 (backend passes the env)
#                                           and AIS_RUN_PGRP=1 (own process group, made the
#                                           terminal's foreground group)
#   backend_child_setup                     optional; in the child right before the exec
#   backend_spawned PID                     optional; after the child started
#   backend_cleanup                         optional; at exit, before the session dir is
#                                           kept or removed
# Hooks other work packages may define (called only if defined): env_build, env_print,
# env_apply (WP5); gates_check, check_run (WP10); exitreport_start, exitreport_finish,
# sessionlog_append (WP7); net_start, net_stop (WP11); profile_preflight_check (WP6).

[ "${AI_SANDBOX-}" != 1 ] || ais_die 126 "already inside an ai-sandbox session (AI_SANDBOX=1); nesting is refused"

# _AIS_TEST_PLATFORM (linux|macos) is honoured only with the stub test backend.
_ais_os=$(uname -s)
if [ -n "${_AIS_TEST_BACKEND-}" ] && [ -n "${_AIS_TEST_PLATFORM-}" ]; then
  case "$_AIS_TEST_PLATFORM" in linux) _ais_os=Linux ;; macos) _ais_os=Darwin ;; esac
fi
case "$_ais_os" in
  Linux) AIS_PLATFORM=linux _ais_backend=bwrap ;;
  Darwin) AIS_PLATFORM=macos _ais_backend=seatbelt ;;
  *) ais_die 126 "unsupported platform: $_ais_os" ;;
esac
unset _ais_os
if [ -n "${_AIS_TEST_BACKEND-}" ]; then
  _ais_backend_file="$AIS_INSTALL_DIR/tests/unit/backend-${_AIS_TEST_BACKEND}.sh"
else
  _ais_backend_file="$AIS_INSTALL_DIR/lib/backend-$_ais_backend.sh"
fi
[ -f "$_ais_backend_file" ] || ais_die 126 "backend not available: $_ais_backend_file"
. "$_ais_backend_file"
unset _ais_backend _ais_backend_file

AIS_PYTHON=$(command -v python3 2>/dev/null) || ais_die 126 "python3 (3.9+) not found"

# ---------------------------------------------------------------------------
# Step 3: config, then profile.

cfg_load "$@"
cfg_load_profile
profile_seed

# The command to run: CLI > AI_SANDBOX_COMMAND > profile; --shell runs bash.
AIS_CMD=()
if [ "$CLI_MODE" = shell ]; then
  AIS_CMD=(bash ${CLI_CMD[@]+"${CLI_CMD[@]}"})
elif [ "$CLI_CMD_SET" = 1 ]; then
  AIS_CMD=("${CLI_CMD[@]}")
elif [ -n "$AI_SANDBOX_COMMAND" ]; then
  set -f
  eval "AIS_CMD=($AI_SANDBOX_COMMAND)" || ais_die 125 "AI_SANDBOX_COMMAND cannot be parsed: $AI_SANDBOX_COMMAND"
  set +f
elif [ "${#PROFILE_COMMAND[@]}" -gt 0 ]; then
  AIS_CMD=("${PROFILE_COMMAND[@]}")
fi
[ "${#AIS_CMD[@]}" -gt 0 ] || [ "$CLI_MODE" = print-policy ] || [ "$CLI_MODE" = check ] ||
  ais_die 125 "no command: profile '$AI_SANDBOX_HARNESS' has none; set AI_SANDBOX_COMMAND or pass one after --"

# ---------------------------------------------------------------------------
# Step 6 (before the IR, because the IR names the session tmp dir): session dir.

AIS_START_TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)
AIS_SESSION_ID="$(date +%Y%m%d-%H%M%S)-$$"
_ais_sessions="$HOME/.local/state/ai-sandbox/sessions"
mkdir -p "$_ais_sessions"
chmod 0700 "$HOME/.local/state/ai-sandbox" "$_ais_sessions"
AIS_SESSION_DIR="$_ais_sessions/$AIS_SESSION_ID"
mkdir -m 0700 "$AIS_SESSION_DIR"
mkdir -m 0700 "$AIS_SESSION_DIR/tmp"
unset _ais_sessions

AIS_CHILD_PID=
AIS_CHILD_RC=
AIS_WATCHDOG_PID=
AIS_KEEP_SESSION=$CLI_KEEP_SESSION

_ais_cleanup() {
  local rc=$?
  trap - EXIT INT QUIT TERM HUP
  ais_hook net_stop || true
  # A backend's watchdog (macOS) must not outlive the child: its group ID could be reused.
  [ -n "${AIS_WATCHDOG_PID-}" ] && kill "$AIS_WATCHDOG_PID" 2>/dev/null
  ais_hook backend_cleanup || true
  if [ -n "$AIS_CHILD_RC" ]; then
    ais_hook exitreport_finish || true
    ais_hook sessionlog_append "$AIS_CHILD_RC" || true
    # Kept after a failure (spec §14), except for --check's own runs (_AIS_CHECK_NO_KEEP).
    [ "$AIS_CHILD_RC" = 0 ] || [ "${_AIS_CHECK_NO_KEEP-}" = 1 ] || AIS_KEEP_SESSION=1
  fi
  if [ "$AIS_KEEP_SESSION" = 1 ]; then
    [ "$CLI_VERBOSE" = 1 ] && ais_warn "session kept: $AIS_SESSION_DIR"
  else
    rm -rf "$AIS_SESSION_DIR"
  fi
  exit "$rc"
}
trap _ais_cleanup EXIT

# Step 7 begins early: the network helper starts now so that its start-up overlaps with
# the policy build; net_wait below waits for it (run modes only).
case "$CLI_MODE" in run | shell) ais_hook net_launch ;; esac

# ---------------------------------------------------------------------------
# Step 4: IR (and environment, WP5).

policy_build "$AIS_SESSION_DIR/policy.ir"
case "$CLI_MODE" in print-policy | check) ;; *) ais_hook env_build; profile_preflight_check ;; esac

# The command must be reachable inside (spec §6): a harness found on the host only through
# a hidden symlink (~/.local/bin/claude) runs by its real path if that is listed; otherwise
# exit 127 now, rather than with a backend-specific error once the sandbox starts.
case "$CLI_MODE" in
  run | shell | dry-run)
    if policy_command_resolve "${AIS_CMD[0]}"; then
      if [ "$POLICY_CMD" != "${AIS_CMD[0]}" ]; then
        [ "$CLI_VERBOSE" = 1 ] && ais_warn "running ${AIS_CMD[0]} by its real path: $POLICY_CMD"
        AIS_CMD[0]=$POLICY_CMD
      fi
    elif [ "$CLI_MODE" = dry-run ]; then
      ais_warn "$POLICY_CMD_ERR"
    else
      ais_die 127 "$POLICY_CMD_ERR"
    fi
    ;;
esac

# Working directory inside: the caller's cwd if it is rw, ro or locked, else the work dir.
AIS_CWD=$(pwd -P)
case "$(policy_class_of "$AIS_CWD")" in
  rw | ro | locked) ;;
  *) AIS_CWD=$POLICY_WORK_DIR ;;
esac

# Step 5: verification gates (WP10). --check measures them, so it does not apply them.
[ "$CLI_MODE" = check ] || ais_hook gates_check

# Step 6 (rest): exit-report manifest (WP7).
case "$CLI_MODE" in run | shell) ais_hook exitreport_start ;; esac

# ---------------------------------------------------------------------------
# Step 8: compile the backend policy. Output-only modes stop here.

backend_preflight

case "$CLI_MODE" in
  print-policy | dry-run)
    ais_hook net_prepare
    backend_compile "$AIS_SESSION_DIR/policy.ir" "$AIS_SESSION_DIR"
    if [ "$CLI_MODE" = print-policy ]; then
      # Paths after --ir (without --) are explained; a command after -- is ignored.
      if [ "$CLI_IR" = 1 ] && [ "$CLI_CMD_SET" = 1 ] && [ "$CLI_DASHDASH" = 0 ]; then
        for _ais_w in "${CLI_CMD[@]}"; do policy_explain "$_ais_w"; done
      elif [ "$CLI_IR" = 1 ]; then
        cat "$AIS_SESSION_DIR/policy.ir"
      else
        backend_print "$AIS_SESSION_DIR"
      fi
      exit 0
    fi
    printf '# policy\n'
    backend_print "$AIS_SESSION_DIR"
    printf '# environment\n'
    ais_hook env_print
    printf 'cwd: %s\n' "$AIS_CWD"
    printf 'command:'
    for _ais_w in "${AIS_CMD[@]}"; do printf ' %s' "$(ais_shquote "$_ais_w")"; done
    printf '\n'
    exit 0
    ;;
  check)
    declare -F check_run >/dev/null || ais_die 126 "--check is not available yet"
    check_run
    exit $?
    ;;
esac

# Step 7: wait for the network helper (WP11), then compile against it.
ais_hook net_wait
backend_compile "$AIS_SESSION_DIR/policy.ir" "$AIS_SESSION_DIR"
ais_hook exitreport_wait

# ---------------------------------------------------------------------------
# Step 9: run the child and supervise it.
#
# The child runs as an asynchronous job so that `wait` can be interrupted to forward
# SIGTERM/SIGHUP. A non-interactive shell starts async jobs with SIGINT/SIGQUIT ignored
# (and `trap -` cannot undo that), so the child is exec'd through a small Python step
# that restores the default dispositions; Ctrl-C then reaches it. The launcher itself
# survives SIGINT so that it can clean up.

backend_command "$AIS_SESSION_DIR" "$AIS_CWD" -- "${AIS_CMD[@]}"

_ais_forward() { # signal
  [ -n "$AIS_CHILD_PID" ] && kill "-$1" "$AIS_CHILD_PID" 2>/dev/null
  return 0
}
trap ':' INT QUIT
trap '_ais_forward TERM' TERM
trap '_ais_forward HUP' HUP

AIS_EXEC_PY='import os,signal,sys
signal.signal(signal.SIGINT, signal.SIG_DFL)
signal.signal(signal.SIGQUIT, signal.SIG_DFL)
env = os.environ
if env.get("_AIS_FG") == "1":
    # Own process group (pgid = this pid, which the launcher knows as $!); take the terminal
    # if the launcher had it, so that terminal signals reach the child directly. Done here
    # rather than with bash job control (set -m), which races setpgid and prints job notices.
    # The controlling terminal is checked, not stdin: with stdin redirected, a child that
    # opens /dev/tty (a password prompt, TIOCSTI) from a background group would be stopped
    # by SIGTTOU/SIGTTIN, and the launcher would wait for it forever.
    tty = -1
    fg = False
    try:
        tty = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
        fg = os.tcgetpgrp(tty) == os.getpgrp()
    except OSError:
        pass
    # A launcher that is a background job on its terminal keeps the child in its group (the
    # job of the caller), so that job control in the calling shell (fg, kill %1) reaches the
    # child; a child in a separate background group would stay stopped after fg. The
    # watchdog then finds no group to end (accepted: the child is in the job of the caller).
    if tty < 0 or fg:
        os.setpgid(0, 0)
    if fg:
        signal.signal(signal.SIGTTOU, signal.SIG_IGN)
        try:
            os.tcsetpgrp(tty, os.getpgrp())
        except OSError:
            pass
        signal.signal(signal.SIGTTOU, signal.SIG_DFL)
    if tty >= 0:
        os.close(tty)
keep = env.get("_AIS_KEEP_ENV")
if keep is not None:
    env = dict((k, env[k]) for k in keep.split() if k in env)
try:
    os.execvpe(sys.argv[1], sys.argv[1:], env)
except FileNotFoundError:
    sys.stderr.write("ai-sandbox: command not found: %s\n" % sys.argv[1]); sys.exit(127)
except PermissionError:
    sys.stderr.write("ai-sandbox: permission denied: %s\n" % sys.argv[1]); sys.exit(126)'

# AIS_RUN_ENV=0: the backend passes the environment itself (bwrap --clearenv/--setenv),
# so the host-side process gets only what it needs to start.
_ais_minimal_env() {
  local v keep=
  for v in PATH HOME XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS; do
    [ -n "${!v+x}" ] && keep="$keep $v"
  done
  for v in $(compgen -e); do
    case " $keep " in *" $v "*) ;; *) export -n "$v" 2>/dev/null || true ;; esac
  done
  export _AIS_KEEP_ENV="$keep"
}

# AIS_RUN_PGRP=1 (macOS): the child makes its own process group and takes the terminal in
# the exec step; the launcher gives the terminal back after it exits.
(
  if [ -n "$AIS_RUN_CWD" ]; then cd "$AIS_RUN_CWD"; fi
  if [ "${AIS_RUN_ENV:-1}" = 1 ]; then ais_hook env_apply; else _ais_minimal_env; fi
  [ "${AIS_RUN_PGRP:-0}" = 1 ] && export _AIS_FG=1
  ais_hook backend_child_setup
  exec "$AIS_PYTHON" -I -S -c "$AIS_EXEC_PY" "${AIS_RUN_ARGV[@]}"
) <&0 &
AIS_CHILD_PID=$!
ais_hook backend_spawned "$AIS_CHILD_PID"

while :; do
  set +e
  wait "$AIS_CHILD_PID"
  _ais_rc=$?
  set -e
  kill -0 "$AIS_CHILD_PID" 2>/dev/null || break
done
AIS_CHILD_RC=$_ais_rc

# Own process group: if the terminal still belongs to the child's (now empty) group, give
# it back to the launcher's group, so that a calling script can use the terminal again.
if [ "${AIS_RUN_PGRP:-0}" = 1 ] && (: </dev/tty) 2>/dev/null; then
  "$AIS_PYTHON" -I -S -c 'import os,signal,sys
signal.signal(signal.SIGTTOU, signal.SIG_IGN)
try:
    t = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    if os.tcgetpgrp(t) == int(sys.argv[1]):
        os.tcsetpgrp(t, os.getpgrp())
except OSError:
    pass' "$AIS_CHILD_PID" || true
fi

# Step 10: cleanup runs from the EXIT trap.
exit "$AIS_CHILD_RC"
