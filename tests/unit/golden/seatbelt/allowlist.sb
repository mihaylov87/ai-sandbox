(version 1)
(allow default)

;; 1. writes: deny all, then devices and Darwin per-user dirs
(deny file-write*)
(allow file-write* (literal "/dev/null") (literal "/dev/zero") (literal "/dev/ptmx")
  (literal "/dev/tty") (regex #"^/dev/ttys[0-9]+$") (literal "/dev/dtracehelper"))
(allow file-write* (subpath "/private/var/folders/xy/abc/T") (subpath "/private/var/folders/xy/abc/C"))
(allow file-write* (subpath "/private/tmp"))

;; 2. IR lines in order, compiled per section 5
(deny file-read* file-write* (subpath "/Users"))
(deny file-read* file-write* (subpath "/Volumes"))
(deny file-read* file-write* (subpath "/Users/jordan"))
(deny file-read* file-write* (subpath "/private/tmp/tmux-501"))
(allow file-read-metadata (literal "/Users") (literal "/Users/jordan"))
(allow file-read* (literal "/Users/jordan/.gitconfig"))
(deny file-write* (literal "/Users/jordan/.gitconfig"))
(allow file-read-metadata (literal "/Users/jordan/.cache"))
(allow file-read* file-write* (subpath "/Users/jordan/.cache/ai-sandbox"))
(allow file-read-metadata (literal "/Users/jordan/src"))
(allow file-read* file-write* (subpath "/Users/jordan/src/app"))
(allow file-read* file-write* (subpath "/Users/jordan/src/we\\ird"))
(allow file-read-metadata (literal "/Users/jordan/.local") (literal "/Users/jordan/.local/state") (literal "/Users/jordan/.local/state/ai-sandbox") (literal "/Users/jordan/.local/state/ai-sandbox/sessions") (literal "/Users/jordan/.local/state/ai-sandbox/sessions/s1"))
(allow file-read* file-write* (subpath "/Users/jordan/.local/state/ai-sandbox/sessions/s1/tmp"))
(allow file-read* (subpath "/opt/ai-sandbox"))
(deny file-write* (subpath "/opt/ai-sandbox"))
(allow file-read-metadata (literal "/Users/jordan/.config") (literal "/Users/jordan/.config/ai-sandbox"))
(allow file-read* (literal "/Users/jordan/.config/ai-sandbox/config"))
(deny file-write* (literal "/Users/jordan/.config/ai-sandbox/config"))
(allow file-read-metadata (literal "/Users/jordan/src/app") (literal "/Users/jordan/src/app/.git"))
(allow file-read* (subpath "/Users/jordan/src/app/.git/hooks"))
(deny file-write* (subpath "/Users/jordan/src/app/.git/hooks"))
(allow file-read* (literal "/Users/jordan/src/app/.git/config"))
(deny file-write* (literal "/Users/jordan/src/app/.git/config"))
(deny file-read* file-write* (subpath "/Users/jordan/src/app/.git/hooks/secret"))

;; 3. IPC that leads outside the sandbox
(deny mach-lookup (global-name "com.apple.SecurityServer") (global-name "com.apple.securityd"))
(deny mach-lookup (global-name "com.apple.pasteboard.1"))
(deny mach-lookup (global-name "com.apple.coreservices.launchservicesd"))
(deny appleevent-send)
(deny signal) (allow signal (target same-sandbox))

;; 4. network (section 9)
(deny network-outbound)
(allow network-outbound (remote ip "localhost:52000"))
(allow network-bind network-inbound (local ip "localhost:*"))
